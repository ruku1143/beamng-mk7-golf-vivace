{
//Gearboxes for the EA888 mod. Physical nodes/beams are copied from the stock Vivace 7DCT / 6M parts.
//VW gearboxes use two output shafts with different final drives. BeamNG has one final drive, so the
//per-gear overall ratios (gear x its final drive) are folded into gearRatios against a stock final drive part:
//  DQ381: use the 4.187:1 final drive (vivace_finaldrive_F_4187 / _R_4187). Golf R configs use 4.37:1 for its shorter overall gearing.
//  MQ350: use the 3.389:1 final drive (vivace_finaldrive_F_3389 / _R_3389).
"vivace_transmission_ea888_DQ381": {
    "information":{
        "authors":"BeamNG, EA888 mod",
        "name":"DQ381 7-Speed DSG (wet clutch)",
        "value":2400,
    },
    "slotType" : "vivace_transmission",
    "components":{
        "transmission":{
            "disableBellHousingTris":true,
        },
    },
    "slots2": [
        ["name",                       "allowTypes",                   "denyTypes", "default",                  "description"],
        ["vivace_transfer_case",       ["vivace_transfer_case"],       [], "vivace_transfer_case_FWD", "Transfer Case"],
        ["vivace_differential_F",      ["vivace_differential_F"],      [], "vivace_differential_F",    "Front Differential"],
        ["vivace_dsg_sound_ea888",     ["vivace_dsg_sound_ea888"],     [], "vivace_dsg_sound_ea888", "DSG Sounds"],
    ],
    "powertrain": [
        ["type", "name", "inputName", "inputIndex"],
        ["dctGearbox", "gearbox", "mainEngine", 1, {"deformGroups":["gearbox"]}],
    ],
    "gearbox": {
        "uiName":"Gearbox",
        //Mk7.5 GTI DQ381: gears 3.40, 2.75, 1.77, 0.93, 0.70, 0.76, 0.64, R 2.90; finals 4.17 / 3.13
        //overall: 14.18 (1st x4.17), 8.61 (2nd x3.13), 5.54 (3rd x3.13), 3.88 (4th x4.17), 2.92 (5th x4.17), 2.38 (6th x3.13), 2.00 (7th x3.13), R 12.09 (x4.17)
        //values below = overall / 4.187
        "gearRatios":[-2.888, 0, 3.386, 2.056, 1.323, 0.926, 0.697, 0.568, 0.478],
        "parkLockTorque":2000,
        "friction":1.34,
        "dynamicFriction":0.00134,
        "torqueLossCoef": 0.0155,
        "gearboxNode:":["tra1l"],
        "additionalEngineInertia":0.06,

        "gearWhineCoefsInput":  [0.25, 0.00, 0.04, 0.04, 0.04, 0.04, 0.04, 0.04, 0.04, 0.04],
        "gearWhineCoefsOutput": [0.00, 0.00, 0.08, 0.08, 0.08, 0.08, 0.08, 0.08, 0.08, 0.08],
        "gearWhineInputEvent": "event:>Vehicle>Transmission>helical_01>twine_in_tuned",
        "gearWhineOutputEvent": "event:>Vehicle>Transmission>helical_01>twine_out_tuned",
    },
    "vehicleController": {
        "calculateOptimalLoadShiftPoints": true,
        "automaticModes":"PRNDSM",
        "transmissionShiftDelay":0.08,
        "shiftDownRPMOffsetCoef":1.2,
        "lowShiftDownRPM":[0,0,0,1400,1500,1400,1400,1400,1400],
        "lowShiftUpRPM":[0,0,2600,2300,2100,2000,1900,1900],
        "clutchLaunchStartRPM":1800,
        "clutchLaunchTargetRPM":2600,
        //short ignition cut on upshifts (triggers the DSG "fart" from the DSG Sounds part)
        "ignitionCutTime":0.10,
    },
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["vivace_transmission", ["vivace_engine","vivace_transmission"]],
    ],
    "nodes": [
         ["id",    "posX", "posY", "posZ"],
         {"selfCollision":false},
         {"collision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"vivace_transmission"},
         {"nodeWeight":9},
         ["tra1r",-0.29,-1.375, 0.32],
         ["tra1l", 0.29,-1.375, 0.32],
         {"nodeWeight":2},
         {"selfCollision":true},
         ["tra2r", 0.37,-1.44, 0.29],
         ["tra2l", 0.37,-1.663,0.305],
         {"group":""},
         //transmission mount node
         ["em1l",  0.37,-1.5,   0.53, {"nodeWeight":3}],
    ],
    "beams": [
          ["id1:",  "id2:"],
          //--TRANSMISSION CONE--
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":6001000,"beamDamp":300},
          {"beamDeform":175000,"beamStrength":"FLT_MAX"},
          {"deformGroup":"gearbox", "deformationTriggerRatio":0.001},
          ["tra1l", "e1r"],
          ["tra1l", "e3l"],
          ["tra1l", "e1l"],
          ["tra1l", "e3r"],
          ["tra1r", "e2r"],
          ["tra1r", "e4l"],
          ["tra1r", "e1r"],
          ["tra1r", "e3l"],
          ["tra1r", "e2l"],
          ["tra1r", "e4r"],
          ["tra1r", "tra1l"],
          ["tra2r", "e1r"],
          ["tra2r", "e3r"],
          ["tra2l", "e1l"],
          ["tra2l", "e3l"],
          ["tra2r", "tra2l"],
          ["tra2r", "tra1l"],
          ["tra2l", "tra1l"],
          ["tra2r", "em1l"],
          ["tra2l", "em1l"],
          {"deformGroup":"", "deformationTriggerRatio":""},

          //transmission mount node
          {"beamSpring":3401000,"beamDamp":150},
          {"beamDeform":90000,"beamStrength":"FLT_MAX"},
          ["em1l",  "e3l"],
          ["em1l",  "e3r"],
          ["em1l",  "e4l"],
          ["em1l",  "e4r"],
          ["em1l",  "e1r"],
          ["em1l",  "e1l"],
          ["em1l",  "e2l"],
          ["em1l",  "e2r"],
          ["em1l",  "tra1l"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
    "triangles":[
        ["id1:",  "id2:",  "id3:"],
        {"groundModel":"metal"},
        {"dragCoef":0},
        ["em1l", "tra2l", "tra2r"],
        ["tra2l", "e1l", "e1r"],
        ["e1r", "tra2r", "tra2l"],
        ["em1l", "tra2r", "tra1l"],
        ["em1l", "tra1l", "e3r"],
        ["tra1l", "e1r", "e3r"],
        ["tra1l", "tra2r", "e1r"],
        ["e1l", "tra2l", "em1l"],
        ["em1l", "e3l", "e1l"],
        ["e3r", "e3l", "em1l"],
    ],
},
"vivace_transmission_ea888_MQ350": {
    "information":{
        "authors":"BeamNG, EA888 mod",
        "name":"MQ350 6-Speed Manual",
        "value":900,
    },
    "slotType" : "vivace_transmission",
    "components":{
        "transmission":{
            "disableBellHousingTris":true,
        },
    },
    "slots2": [
        ["name",                  "allowTypes",              "denyTypes", "default",                  "description"],
        ["vivace_flywheel",       ["vivace_flywheel"],       [], "vivace_flywheel",          "Flywheel",           {"coreSlot":true}],
        ["vivace_transfer_case",  ["vivace_transfer_case"],  [], "vivace_transfer_case_FWD", "Transfer Case"],
        ["vivace_differential_F", ["vivace_differential_F"], [], "vivace_differential_F",    "Front Differential"],
    ],
    "powertrain": [
        ["type", "name", "inputName", "inputIndex"],
        ["manualGearbox", "gearbox", "clutch", 1, {"deformGroups":["gearbox"]}],
    ],
    "gearbox": {
        "uiName":"Gearbox",
        //Mk7.5 GTI MQ350 (02Q): gears 3.77, 2.09, 1.47, 1.09, 1.10, 0.91, R 4.55; finals 3.24 (1-4) / 2.62 (5, 6, R)
        //overall: 12.21, 6.77, 4.76, 3.53, 2.88, 2.38, R 11.92
        //values below = overall / 3.389
        "gearRatios":[-3.518, 0, 3.604, 1.998, 1.405, 1.042, 0.850, 0.703],
        "friction":1.21,
        "dynamicFriction":0.00122,
        "torqueLossCoef": 0.0155,
        "gearboxNode:":["tra1l"],

        "gearWhineCoefsInput":  [0.20, 0.00, 0.04, 0.04, 0.04, 0.04, 0.04, 0.04, 0.04, 0.04],
        "gearWhineCoefsOutput": [0.00, 0.00, 0.06, 0.06, 0.06, 0.06, 0.06, 0.06, 0.06, 0.06],
        "gearWhineInputEvent": "event:>Vehicle>Transmission>helical_01>twine_in",
        "gearWhineOutputEvent": "event:>Vehicle>Transmission>helical_01>twine_out",
    },
    "vehicleController": {
        "calculateOptimalLoadShiftPoints": true,
        "shiftDownRPMOffsetCoef":1.23,
        "lowShiftDownRPM":[0,0,0,1400,1500,1400,1400,1400],
        "lowShiftUpRPM":[0,0,3300,2900,2600,2600,2600],
    },
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["vivace_transmission", ["vivace_engine","vivace_transmission"]],
    ],
    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],
        //manual transmission
        //["clutch", "vivace_clutchpedal", "f1l","f1r","f6l", {"x":5, "y":0, "z":180}, {"x":-25, "y":0, "z":0}, {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1],
    ],
    "nodes": [
         ["id",    "posX", "posY", "posZ"],
         {"selfCollision":false},
         {"collision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"vivace_transmission"},
         {"nodeWeight":5},
         ["tra1r",-0.29,-1.375, 0.32],
         ["tra1l", 0.29,-1.375, 0.32],
         {"nodeWeight":2},
         {"selfCollision":true},
         ["tra2r", 0.37,-1.44, 0.29],
         ["tra2l", 0.37,-1.663,0.305],
         {"group":""},
         //transmission mount node
         ["em1l",  0.37,-1.5,   0.53, {"nodeWeight":3}],
    ],
    "beams": [
          ["id1:",  "id2:"],
          //--TRANSMISSION CONE--
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":6001000,"beamDamp":300},
          {"beamDeform":175000,"beamStrength":"FLT_MAX"},
          {"deformGroup":"gearbox", "deformationTriggerRatio":0.001},
          ["tra1l", "e1r"],
          ["tra1l", "e3l"],
          ["tra1l", "e1l"],
          ["tra1l", "e3r"],
          ["tra1r", "e2r"],
          ["tra1r", "e4l"],
          ["tra1r", "e1r"],
          ["tra1r", "e3l"],
          ["tra1r", "e2l"],
          ["tra1r", "e4r"],
          ["tra1r", "tra1l"],
          ["tra2r", "e1r"],
          ["tra2r", "e3r"],
          ["tra2l", "e1l"],
          ["tra2l", "e3l"],
          ["tra2r", "tra2l"],
          ["tra2r", "tra1l"],
          ["tra2l", "tra1l"],
          ["tra2r", "em1l"],
          ["tra2l", "em1l"],
          {"deformGroup":"", "deformationTriggerRatio":""},

          //transmission mount node
          {"beamSpring":3401000,"beamDamp":150},
          {"beamDeform":90000,"beamStrength":"FLT_MAX"},
          ["em1l",  "e3l"],
          ["em1l",  "e3r"],
          ["em1l",  "e4l"],
          ["em1l",  "e4r"],
          ["em1l",  "e1r"],
          ["em1l",  "e1l"],
          ["em1l",  "e2l"],
          ["em1l",  "e2r"],
          ["em1l",  "tra1l"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
    "triangles":[
        ["id1:",  "id2:",  "id3:"],
        {"groundModel":"metal"},
        {"dragCoef":0},
        ["em1l", "tra2l", "tra2r"],
        ["tra2l", "e1l", "e1r"],
        ["e1r", "tra2r", "tra2l"],
        ["em1l", "tra2r", "tra1l"],
        ["em1l", "tra1l", "e3r"],
        ["tra1l", "e1r", "e3r"],
        ["tra1l", "tra2r", "e1r"],
        ["e1l", "tra2l", "em1l"],
