{
//EA888 Gen 3 (MQB) 2.0 TSI for the Cherrier Vivace
//Physical nodes/beams/flexbodies are copied from the stock BeamNG vivace_engine_i4_2.0_petrol so the engine fits the stock body, mounts and exhausts.
//Torque data: the base curve is a naturally aspirated EA888 equivalent; boost comes from the turbo part and the ECU torque map,
//calibrated offline against the game's turbocharger maths to Mk7.5 factory figures (GTI 230 PS/350 Nm, GTI Performance 245 PS/370 Nm, R 310 PS/400 Nm).
"vivace_engine_ea888": {
    "information":{
        "authors":"BeamNG, EA888 mod (sounds: Hell_Raiser_999)",
        "name":"2.0L EA888 Gen 3 TSI I4 Engine",
        "value":8200,
    },
    "slotType" : "vivace_engine",
    "slots2": [
        ["name",                           "allowTypes",                      "denyTypes", "default",                        "description"],
        ["vivace_enginemounts",            ["vivace_enginemounts"],           [], "vivace_enginemounts",            "Engine Mounts",        {"coreSlot":true}],
        ["vivace_oilpan",                  ["vivace_oilpan"],                 [], "vivace_oilpan",                  "Oil Pan",              {"coreSlot":true}],
        ["vivace_intake_ea888",            ["vivace_intake_ea888"],           [], "vivace_turbo_ea888_IS20",        "Turbocharger",         {"coreSlot":true}],
        ["vivace_engine_ecu_ea888",        ["vivace_engine_ecu_ea888"],       [], "vivace_engine_ecu_ea888_gti",    "Engine Management",    {"coreSlot":true}],
        ["vivace_engine_internals_ea888",  ["vivace_engine_internals_ea888"], [], "vivace_engine_internals_ea888_gti", "Engine Long Block", {"coreSlot":true}],
        ["vivace_engine_sound_ea888",      ["vivace_engine_sound_ea888"],     [], "vivace_engine_sound_ea888_stock", "Exhaust Sound"],
        ["vivace_soundaktor_ea888",        ["vivace_soundaktor_ea888"],       [], "vivace_soundaktor_ea888",        "Soundaktor"],
        ["n2o_system",                     ["n2o_system"],                    [], "",                               "Nitrous Oxide System"],
        ["vivace_transmission",            ["vivace_transmission"],           [], "vivace_transmission_ea888_DQ381", "Transmission"],
    ],
    "components":{
        "engineType": {
          "ICE": true
          "EV": false
        },
        //same values as the stock 2.0 so the stock exhausts behave as they do on the stock engine
        "soundConfigExhaustComponents": {
          "base": {
          "addLowShelfGain":8,
          "addHighShelfGain":-6,
          "addEqFundamentalGain":0,
          "addEqHighGain":-6,
          "nodeAfterFireAudioCoef":0.15,
          "nodeAfterFireVisualCoef":0.15,
          "nodeAfterFireVolumeCoef":0.4,
          "nodeAfterFireMufflingCoef":0.0,
          "nodeExhaustAudioMufflingCoef":0.00,
          "nodeExhaustAudioGainChange":-3
        },
        "sport":{
          "addLowShelfGain":11,
          "addHighShelfGain":-5,
          "addEqFundamentalGain":2,
          "addEqHighGain":-5,
          "nodeAfterFireAudioCoef":0.4,
          "nodeAfterFireVisualCoef":0.0,
          "nodeAfterFireVolumeCoef":0.5,
          "nodeAfterFireMufflingCoef":0.30,
          "nodeExhaustAudioMufflingCoef":0.25,
          "nodeExhaustAudioGainChange":-2
        },
        "tuned":{
          "addLowShelfGain":16,
          "addHighShelfGain":3,
          "addEqFundamentalGain":6,
          "addEqHighGain":0,
          "nodeAfterFireAudioCoef":0.8,
          "nodeAfterFireVisualCoef":0.5,
          "nodeAfterFireVolumeCoef":0.8,
          "nodeAfterFireMufflingCoef":0.50,
          "nodeExhaustAudioMufflingCoef":0.35,
          "nodeExhaustAudioGainChange":-1
        },
        "race":{
          "addLowShelfGain":12,
          "addHighShelfGain":0,
          "addEqFundamentalGain":2,
          "addEqLowGain":0,
          "addEqHighGain":0,
          "nodeAfterFireAudioCoef":0.9,
          "nodeAfterFireVisualCoef":0.8,
          "nodeAfterFireVolumeCoef":1.0,
          "nodeAfterFireMufflingCoef":0.75,
          "nodeExhaustAudioMufflingCoef":0.66,
          "nodeExhaustAudioGainChange":0
        },
      },
    },
    "powertrain": [
        ["type", "name", "inputName", "inputIndex"],
        ["combustionEngine", "mainEngine", "dummy", 0],
    ],
    "mainEngine":{
        //naturally aspirated equivalent of the 1984cc EA888 (82.5 x 92.8 mm); boost is added by the turbo and ECU parts
        "torque":[
            ["rpm", "torque"],
            [0, 0],
            [500, 118],
            [1000, 148],
            [1500, 168],
            [2000, 182],
            [2500, 190],
            [3000, 195],
            [3500, 198],
            [4000, 199],
            [4500, 198],
            [5000, 195],
            [5500, 190],
            [6000, 184],
            [6500, 176],
            [7000, 165],
            [7500, 150],
        ],
        "idleRPM":750,
        //max rpm physically capable of
        "maxRPM":7000,
        "revLimiterType":"timeBased",
        "inertia":0.11,
        "friction":11,
        "dynamicFriction":0.014,
        "engineBrakeTorque":50,
        "burnEfficiency":[
            [0, 0.12],
            [0.05, 0.29],
            [0.4, 0.41],
            [0.7, 0.5],
            [1, 0.36],
        ],
        //fuel system
        "energyStorage": "mainTank",
        "requiredEnergyType":"gasoline",

        //exhaust
        "instantAfterFireSound": "event:>Vehicle>Afterfire>i4_01>single",
        "sustainedAfterFireSound": "event:>Vehicle>Afterfire>i4_01>multi",
        "shiftAfterFireSound": "event:>Vehicle>Afterfire>i4_01>shift",
        "particulates":0.02,
        "instantAfterFireCoef": 0.75,
        "sustainedAfterFireCoef": 0.75,
        "instantAfterFireVolumeCoef": 1.0,
        "sustainedAfterFireVolumeCoef": 0.7,
        "shiftAfterFireVolumeCoef": 0.9,

        //cooling and oil system
        "thermalsEnabled":true,
        //EA888 Gen 3: cast iron block, aluminium head
        "engineBlockMaterial":"iron",
        "oilVolume":5.7,
        "engineBlockAirCoolingEfficiency":24,

        //engine durability
        "cylinderWallTemperatureDamageThreshold":120,
        "headGasketDamageThreshold":1500000,
        "pistonRingDamageThreshold":1500000,
        "connectingRodDamageThreshold":2000000,
        "maxTorqueRating": 460,
        "maxOverTorqueDamage": 250,

        //node beam interface
        "torqueReactionNodes:":["e1l","e2l","e4r"],
        "waterDamage": {"[engineGroup]:":["engine_intake"]},
        "radiator": {"[engineGroup]:":["radiator"]},
        "engineBlock": {"[engineGroup]:":["engine_block"]},
        "breakTriggerBeam":"engine",
        "uiName":"Engine",
        "soundConfig": "soundConfig",
        "soundConfigExhaust": "soundConfigExhaust",

        //starter motor
        "starterSample":"event:>Engine>Starter>i4_1996_eng",
        "starterSampleExhaust":"event:>Engine>Starter>i4_1996_exh",
        "shutOffSampleEngine":"event:>Engine>Shutoff>i4_1996_eng",
        "shutOffSampleExhaust":"event:>Engine>Shutoff>i4_1996_exh",
        "starterVolume":0.76,
        "starterVolumeExhaust":0.76,
        "shutOffVolumeEngine":0.76,
        "shutOffVolumeExhaust":0.76,
        "starterThrottleKillTime":0.65,
        "idleRPMStartRate":2,
        "idleRPMStartCoef":1,

        //damage deformGroups
        "deformGroups":["mainEngine", "mainEngine_piping", "mainEngine_accessories"]
        "deformGroups_oilPan":["oilpan_damage"]
    },
    //engine (intake side) samples recorded from an EA888 (from Hell_Raiser_999's TSI mod), gains from that mod
    "soundConfig": {
        "sampleName": "ea888_eng",
        "intakeMuffling": 1,

        "mainGain": 15,
        "onLoadGain":1,
        "offLoadGain":0.48,

        "maxLoadMix": 0.65,
        "minLoadMix": 0,

        "lowShelfGain":0,
        "lowShelfFreq":120,

        "highShelfGain":0.0,
        "highShelfFreq":10000,

        "eqLowGain": 0,
        "eqLowFreq": 120,
        "eqLowWidth": 0.05,

        "eqHighGain": -2.5,
        "eqHighFreq": 2500,
        "eqHighWidth": 0.01,

        "fundamentalFrequencyCylinderCount":4,
        "eqFundamentalGain":0,
    },
    //exhaust samples are chosen in the "Exhaust Sound" slot (vivace_engine_sound_ea888)
    "soundConfigExhaust": {
        "sampleName": "ea888_exh",

        "mainGain": 15.0,
        "onLoadGain":1,
        "offLoadGain":0.28

        "maxLoadMix": 0.63,
        "minLoadMix": 0,

        "lowShelfGain":0,
        "lowShelfFreq":20,

        "highShelfGain":0,
        "highShelfFreq":10000,

        "eqLowGain": 0,
        "eqLowFreq": 120,
        "eqLowWidth": 0.01,

        "eqHighGain": -18,
        "eqHighFreq": 2300,
        "eqHighWidth": 0.02,

        "fundamentalFrequencyCylinderCount":4,
        "eqFundamentalGain": 3
    },
    "vehicleController": {
        "clutchLaunchStartRPM":1600,
        "clutchLaunchTargetRPM":2200,
        //**highShiftDown can be overwritten by automatic transmissions**
        "highShiftDownRPM":[0,0,0,2800,3300,3600,3800,3800],
        //**highShiftUp can be overwritten by intake modifications**
        "highShiftUpRPM":6300,
    },
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["vivace_engine_i4", ["vivace_engine"]],
         ["vivace_intake_i4", ["vivace_engine"]],
    ],
    "nodes": [
         ["id",   "posX", "posY", "posZ"],
         //--2.0L I4 Engine--
         {"selfCollision":false},
         {"collision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"vivace_engine"},
         {"engineGroup":"engine_block"},
         {"nodeWeight":9.375},
         ["e1r",  0.11,-1.44, 0.27, {"chemEnergy":1000,"burnRate":0.39,"flashPoint":800,"specHeat": 0.2,"selfIgnitionCoef":false,"smokePoint":650,"baseTemp":"thermals","conductionRadius":0.12}],
         ["e1l",  0.11,-1.663,0.285],
         ["e2r", -0.23,-1.44, 0.27, {"chemEnergy":1000,"burnRate":0.39,"flashPoint":800,"specHeat": 0.2,"selfIgnitionCoef":false,"smokePoint":650,"baseTemp":"thermals","conductionRadius":0.12}],
         ["e2l", -0.23,-1.663,0.285],
         {"engineGroup":["engine_block","engine_intake"]},
         ["e3r",  0.11,-1.410,0.655, {"chemEnergy":1000,"burnRate":0.39,"flashPoint":800,"specHeat": 0.2,"selfIgnitionCoef":false,"smokePoint":650,"baseTemp":"thermals","conductionRadius":0.12}],
         ["e3l",  0.11,-1.633,0.670, {"isExhaust":"mainEngine"}],
         ["e4r", -0.23,-1.410,0.655, {"chemEnergy":1000,"burnRate":0.39,"flashPoint":800,"specHeat": 0.2,"selfIgnitionCoef":false,"smokePoint":650,"baseTemp":"thermals","conductionRadius":0.12}],
         ["e4l", -0.23,-1.633,0.670],
         ["tc1",  0,   -1.664,0.397],
         {"engineGroup":""},
         {"group":""},
         //collision nodes
         {"nodeWeight":7.03125},
         {"selfCollision":true},
         //engine face apex nodes (intake, exhaust, valve cover, accessory)
         ["intk", -0.06,-1.76, 0.48],
         ["exhm", -0.06,-1.37, 0.46],
         ["vcov", -0.06,-1.51, 0.76],
         ["eacc", -0.33,-1.54, 0.47],
         {"nodeWeight":12.5},
         //engine mount node
         ["em1r",-0.40,-1.5,  0.64, {"nodeWeight":3}],
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":901000,"beamDamp":200},
          {"beamDeform":175000,"beamStrength":"FLT_MAX"},
          //engine
          {"deformGroup":"mainEngine", "deformationTriggerRatio":0.001}
          ["e1r",  "e1l"],
          ["e2r",  "e2l"],
          ["e3r",  "e3l"],
          ["e4r",  "e4l"],

          ["e1r",  "e2r"],
          ["e1l",  "e2l"],
          ["e3r",  "e4r"],
          ["e3l",  "e4l"],

          ["e1r",  "e3r"],
          ["e1l",  "e3l"],
          ["e2r",  "e4r"],
          ["e2l",  "e4l"],

          ["e2r",  "e3r"],
          ["e2l",  "e3l"],
          ["e2r",  "e3l"],
          ["e2l",  "e3r"],

          ["e1r",  "e4r"],
          ["e1l",  "e4l"],
          ["e1r",  "e4l"],
          ["e1l",  "e4r"],

          ["e1r",  "e2l"],
