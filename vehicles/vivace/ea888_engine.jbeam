"vivace_turbo_ea888_IS20": {
    "information":{
        "authors":"BeamNG, EA888 mod",
        "name":"IHI IS20 Turbocharger (GTI)",
        "value":1350,
    },
    "slotType" : "vivace_intake_ea888",
    //IS20: 42.5/54.0 mm compressor, 8 blade turbine, electric wastegate. Early spool, fades at the top end.
    //wastegate target is set by the ECU part
    "turbocharger": {
        "bovSoundFileName":"event:>Vehicle>Forced_Induction>Turbo_01>turbo_bov",
        "hissLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_01>turbo_hiss",
        "whineLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_01>turbo_spin",
        "turboSizeCoef": 0.75,
        "bovSoundVolumeCoef": 0.30,
        "hissVolumePerPSI": 0.012,
        "whineVolumePer10kRPM": 0.024,
        "whinePitchPer10kRPM": 0.065,
        "wastegateStart":14.0,
        "wastegateLimit":15.0,
        "maxExhaustPower": 1500,
        "backPressureCoef": 0.0000005,
        "pressureRatePSI": 26,
        "frictionCoef": 15.5,
        "inertia":0.30,
        "damageThresholdTemperature": 650,
        "deformGroupDamageScaleCoef": 15,
        "pressurePSI":[
            //turbineRPM, pressure(PSI)
            [0,         -3.5],
            [30000,     -1.5],
            [60000,     8],
            [90000,     16],
            [150000,    21],
            [200000,    24],
            [250000,    26],
        ],
        "engineDef":[
            //engineRPM, efficiency, exhaustFactor
            //efficiency solved so the GTI ECU gives 350 Nm 1500-4600 rpm and 230 PS 4700-6200 rpm at the crank
            [0,     0.0,    0.0],
            [500,   0.0,    0.15],
            [750,   0.161,  0.25],
            [1000,  0.501,  0.4],
            [1250,  1.006,  0.55],
            [1500,  1.307,  0.75],
            [1750,  1.238,  0.9],
            [2000,  1.165,  1.0],
            [2500,  1.09,   1.0],
            [3000,  1.057,  1.0],
            [3500,  1.043,  1.0],
            [4000,  1.051,  1.0],
            [4500,  1.079,  1.0],
            [5000,  0.965,  1.0],
            [5500,  0.85,   1.0],
            [6000,  0.774,  1.0],
            [6500,  0.721,  1.0],
            [7000,  0.427,  1.0],
        ],
    },
    "soundConfig": {
        "$+maxLoadMix": 0.1,
        "$+intakeMuffling":-0.3,
    },
    "mainEngine":{
        //turbocharger name
        "turbocharger":"turbocharger",
        "$*instantAfterFireCoef": 1.5,
        "$*sustainedAfterFireCoef": 1.5,

        //damage deformGroups
        "deformGroups_turbo":["mainEngine_turbo","mainEngine_intercooler","mainEngine_intercoolerPiping"]
    },
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["vivace_enginecover_i4", ["vivace_engine"]],
         ["vivace_intakecover_i4", ["vivace_engine"]],
         ["vivace_turbo_i4", ["vivace_engine", "vivace_downpipe"]],
         ["vivace_intercooler", ["vivace_intercooler"]],
         {"deformGroup":"mainEngine_intercoolerPiping", "deformMaterialBase":"vivace_mechanical", "deformMaterialDamaged":"invis"},
         ["vivace_intercooler_tubing", ["vivace_intercooler","vivace_intake","vivace_turbo"]],
         {"deformGroup":"airbox", "deformMaterialBase":"vivace_mechanical", "deformMaterialDamaged":"invis"},
         ["vivace_airbox", ["vivace_engine","vivace_airbox", "vivace_intake"]],
         {"deformGroup":""},
    ],
    "nodes": [
         ["id",     "posX", "posY", "posZ"],
         //--turbo and intercooler weight--
         {"selfCollision":false},
         {"collision":false},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"vivace_turbo"},
         {"nodeWeight":8},
         ["turbo", -0.15,-1.35, 0.55],
         {"collision":true},
         {"group":"vivace_intercooler"},
         {"nodeWeight":0.5},
         ["interc1r",-0.3, -1.96, 0.25],
         ["interc1",  0.0, -1.96, 0.25,{"nodeWeight":0.7}],
         ["interc1l", 0.3, -1.96, 0.25],
         ["interc2r",-0.3, -1.96, 0.40],
         ["interc2",  0.0, -1.96, 0.40,{"nodeWeight":0.7}],
         ["interc2l", 0.3, -1.96, 0.40],
         {"nodeWeight":1.25},
         ["interc3",  0.0, -1.80, 0.325],
         {"nodeWeight":1},
         {"group":"vivace_intake"},
         ["airb1",  0.4, -1.55, 0.74],
         ["airb2",  0.1, -1.75, 0.65],
         {"group":"vivace_downpipe"},
         {"nodeWeight":1.7},
         ["exd1",   0.08,-1.17, 0.43],
         {"group":""},
    ],
    "beams": [
          ["id1:",   "id2:"],
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          //turbo
          {"beamSpring":2750550,"beamDamp":125},
          {"beamDeform":30000,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":""},
          {"deformGroup":"mainEngine_turbo", "deformationTriggerRatio":0.001}
          ["turbo",  "e1r"],
          ["turbo",  "e1l"],
          ["turbo",  "e2r"],
          ["turbo",  "e2l"],
          ["turbo",  "e3r"],
          ["turbo",  "e3l"],
          ["turbo",  "e4r"],
          ["turbo",  "e4l"],

