    "triangles":[
        ["id1:",  "id2:",  "id3:"],
        {"groundModel":"metal"},

        //interior
        {"dragCoef":0},
            //intake side
            ["e3l", "intk", "e1l"],
            ["e3l", "e4l", "intk"],
