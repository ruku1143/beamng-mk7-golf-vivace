          ["tc1",  "e2l"],
          ["tc1",  "e2r"],
          {"deformGroup":"", "deformationTriggerRatio":""}
          {"breakGroup":""},

          //engine mount node
          {"beamSpring":2400100,"beamDamp":150},
          {"beamDeform":90000,"beamStrength":"FLT_MAX"},
          ["em1r", "e3l"],
          ["em1r", "e3r"],
          ["em1r", "e4l"],
          ["em1r", "e4r"],
          ["em1r", "e1r"],
