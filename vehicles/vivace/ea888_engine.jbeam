"vivace_turbo_ea888_IS38": {
    "information":{
        "authors":"BeamNG, EA888 mod",
        "name":"IHI IS38 Turbocharger (Golf R)",
        "value":1900,
    },
    "slotType" : "vivace_intake_ea888",
    //IS38: 45.2/58.0 mm compressor, 8 blade turbine, electric wastegate. Spools ~500 rpm later than the IS20, holds boost to the limiter.
    //wastegate target is set by the ECU part
    "turbocharger": {
        "bovSoundFileName":"event:>Vehicle>Forced_Induction>Turbo_01>turbo_bov",
        "hissLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_01>turbo_hiss",
        "whineLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_01>turbo_spin",
        "turboSizeCoef": 0.85,
        "bovSoundVolumeCoef": 0.36,
        "hissVolumePerPSI": 0.014,
        "whineVolumePer10kRPM": 0.026,
        "whinePitchPer10kRPM": 0.058,
        "wastegateStart":17.0,
        "wastegateLimit":18.0,
        "maxExhaustPower": 1700,
        "backPressureCoef": 0.0000005,
        "pressureRatePSI": 24,
        "frictionCoef": 17,
        "inertia":0.42,
        "damageThresholdTemperature": 680,
        "deformGroupDamageScaleCoef": 15,
        "pressurePSI":[
            //turbineRPM, pressure(PSI)
            [0,         -3.5],
            [30000,     -2],
            [60000,     4],
            [90000,     12],
            [150000,    22],
            [200000,    27],
            [250000,    30],
        ],
        "engineDef":[
            //engineRPM, efficiency, exhaustFactor
            //efficiency solved so the R ECU gives 400 Nm 2000-5200 rpm and 310 PS 5500-6500 rpm at the crank
            [0,     0.0,    0.0],
            [500,   0.0,    0.1],
            [750,   0.0,    0.18],
            [1000,  0.383,  0.3],
            [1250,  0.564,  0.42],
            [1500,  0.827,  0.58],
            [1750,  1.081,  0.75],
            [2000,  1.228,  0.9],
            [2500,  1.158,  1.0],
            [3000,  1.126,  1.0],
            [3500,  1.112,  1.0],
            [4000,  1.119,  1.0],
            [4500,  1.145,  1.0],
            [5000,  1.193,  1.0],
            [5500,  1.246,  1.0],
            [6000,  1.157,  1.0],
            [6500,  1.123,  1.0],
            [7000,  0.956,  1.0],
        ],
    },
    "soundConfig": {
        "$+maxLoadMix": 0.12,
        "$+intakeMuffling":-0.35,
    },
    "mainEngine":{
        //turbocharger name
        "turbocharger":"turbocharger",
        "$*instantAfterFireCoef": 1.6,
        "$*sustainedAfterFireCoef": 1.6,

        //damage deformGroups
        "deformGroups_turbo":["mainEngine_turbo","mainEngine_intercooler","mainEngine_intercoolerPiping"]
    },
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["vivace_enginecover_i4", ["vivace_engine"]],
         ["vivace_intakecover_i4", ["vivace_engine"]],
         ["vivace_turbo_i4", ["vivace_engine", "vivace_downpipe"]],
         ["vivace_intercooler", ["vivace_intercooler"]],
         {"deformGroup":"mainEngine_intercoolerPiping", "deformMaterialBase":"vivace_mechanical", "deformMaterialDamaged":"invis"},
         ["vivace_intercooler_tubing", ["vivace_intercooler","vivace_intake","vivace_turbo"]],
         {"deformGroup":"airbox", "deformMaterialBase":"vivace_mechanical", "deformMaterialDamaged":"invis"},
         ["vivace_airbox", ["vivace_engine","vivace_airbox", "vivace_intake"]],
         {"deformGroup":""},
    ],
    "nodes": [
         ["id",     "posX", "posY", "posZ"],
         //--turbo and intercooler weight--
         {"selfCollision":false},
         {"collision":false},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"vivace_turbo"},
         {"nodeWeight":8},
         ["turbo", -0.15,-1.35, 0.55],
         {"collision":true},
         {"group":"vivace_intercooler"},
         {"nodeWeight":0.5},
